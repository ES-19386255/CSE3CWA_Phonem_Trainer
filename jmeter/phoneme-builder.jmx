<hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Find the Word Search id" enabled="true">
  <stringProp name="JSONPostProcessor.referenceNames">searchId</stringProp>
  <stringProp name="JSONPostProcessor.jsonPathExprs">$[?(@.title=='Starter Word Search')].id</stringProp>
  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
  <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
</JSONPostProcessor>
<hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Find the Wordle id" enabled="true">
