# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# zips of the project (submission or downloaded step files)
*.zip

# misc
.DS_Store
*.pem
/docs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma: the generated client is rebuilt from schema.prisma automatically
# (see the "postinstall" script in package.json), so it doesn't need to be
# committed. The actual SQLite database file is local-only too.
/lib/generated
/prisma/*.db
/prisma/*.db-journal
# WAL mode makes SQLite create two extra files next to the database
/prisma/*.db-wal
/prisma/*.db-shm

# Playwright test output (reports, screenshots, traces)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Lighthouse reports made by scripts/lighthouse-audit.mjs
/lighthouse-reports/

# JMeter output (made by jmeter/run-stages.sh)
/jmeter/results/
